<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumo da viagem"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResumoDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Destino:"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtResumoDataPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Data de partida:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtResumoDataRetorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Data de retorno:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtResumoPreferencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preferências:"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Atividade selecionada"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgResumoAtividade"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Imagem da atividade selecionada"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/txtResumoNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nome da atividade"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtResumoDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Descrição da atividade"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtResumoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categoria:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtResumoDuracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Duração escolhida:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtResumoDificuldade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dificuldade escolhida:"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnFinalizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Finalizar" />

    </LinearLayout>

</ScrollView>
